# Local MongoDB server. Add your MongoDB username/password here only if authentication is enabled.
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=collectflow

# Generate a private key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
SESSION_TTL_HOURS=168

# Keep false for localhost HTTP. Set true after deploying behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Vite proxy is same-origin in local development. These are for direct API calls if needed.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Dashboard routes. Change these to match your Dashboard folder's actual React routes.
CREDITOR_DASHBOARD_PATH=/dashboard/reditor
AGENCY_DASHBOARD_PATH=/dashboard/agency
DEBTOR_PORTAL_PATH=/dashboard/debtor
